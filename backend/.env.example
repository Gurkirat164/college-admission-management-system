# Setup creates backend/.env with project-local random credentials.
# Never point MIGRATION_DATABASE_URL at an unrelated or production database.
DATABASE_URL=postgresql://admission_app:CHANGE_ME@127.0.0.1:55432/admission
MIGRATION_DATABASE_URL=postgresql://admission_owner:CHANGE_ME@127.0.0.1:55432/admission
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
UPLOAD_DIR=.local/uploads
STORAGE_BACKEND=local
MOCK_RUN_TIME=02:00
SCHEDULER_TIMEZONE=Asia/Kolkata
# Optional persistent private storage adapter, configured only when deploying:
# pip install './backend[s3]'
# STORAGE_BACKEND=s3
# S3_BUCKET=private-admission-documents
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_REGION=ap-southeast-1
# Supply AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY through the environment.
